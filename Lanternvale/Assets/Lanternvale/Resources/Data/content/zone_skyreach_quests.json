{
  "_note": "Skyreach Peaks (Docs/Expansion.md §8, builder skyreach, prefixes sr / dg6). The main story Ash on the Wind and the zone's side quests.",
  "quests": [
    {
      "id": "mq2_ash_on_the_wind",
      "name": "Ash on the Wind",
      "giver": "bw_archivist_penhallow",
      "level": 24,
      "minLevel": 24,
      "zone": "skyreach",
      "main": true,
      "summary": "The ash comes from the peaks. Climb into Skyreach, read the ash at the Bone Field, and learn who serves the sleeping Ashwyrm.",
      "stages": [
        {
          "id": "peaks",
          "description": "Climb north-west from Brightwater into Skyreach Peaks.",
          "objectives": [{"type": "Reach", "target": "skyreach", "text": "Travel to Skyreach Peaks"}],
          "next": "guide"
        },
        {
          "id": "guide",
          "description": "Find a guide in Cairnhollow, the mountain hut village, and ask about the ash.",
          "objectives": [{"type": "Talk", "target": "sr_guide_odran", "text": "Speak with Odran Fellstep"}],
          "next": "bones",
          "onComplete": [{"type": "GiveXP", "amount": 250}]
        },
        {
          "id": "bones",
          "description": "Go up the Switchbacks to the Bone Field and read the ash on the old dragon's bones. Magistra Ottoline may help.",
          "objectives": [{"type": "Flag", "target": "sr_bones_read", "text": "Read the ash on the dragon bones"}],
          "next": "scout",
          "onComplete": [{"type": "GiveXP", "amount": 420}],
          "turnIn": "sr_ottoline"
        },
        {
          "id": "scout",
          "description": "Find Ivo Tallowmere, the Brightwater scout hiding south-east of the Dragonsworn camp.",
          "objectives": [{"type": "Talk", "target": "sr_scout_ivo", "text": "Speak with Ivo the scout"}],
          "next": "marshal",
          "onComplete": [{"type": "GiveXP", "amount": 250}]
        },
        {
          "id": "marshal",
          "description": "Defeat Vanguard-Marshal Kaedric in the Dragonsworn camp and take Highlord Varkas's orders.",
          "objectives": [
            {"type": "Defeat", "target": "enc_sr_marshal", "text": "Defeat Vanguard-Marshal Kaedric"},
            {"type": "Collect", "target": "sr_varkas_orders", "text": "Highlord Varkas's orders"}
          ],
          "next": "gate",
          "onComplete": [{"type": "GiveXP", "amount": 730}]
        },
        {
          "id": "gate",
          "description": "The orders speak of a gate. Find it, above the camp.",
          "objectives": [{"type": "Reach", "target": "reg_sr_roost_gate", "text": "Find the Roost Gate"}],
          "next": "report",
          "onComplete": [{"type": "GiveXP", "amount": 250}]
        },
        {
          "id": "report",
          "description": "Bring word back to Archivist Penhallow in Brightwater.",
          "objectives": [{"type": "Talk", "target": "bw_archivist_penhallow", "text": "Speak with Archivist Penhallow"}],
          "onComplete": [{"type": "SetFlag", "key": "mq2_ash_on_the_wind_done"}]
        }
      ],
      "rewards": {"xp": 1180, "gold": 9000, "choiceItems": ["sr_vanguard_breakers_helm", "sr_windrider_hood", "sr_archivists_ember_lens"]}
    },
    {
      "id": "sr_woolly_business",
      "name": "Woolly Business",
      "giver": "sr_pema",
      "level": 24,
      "minLevel": 24,
      "zone": "skyreach",
      "summary": "Pema's three goats ran off when the mountain shook: Bramble, who climbs; Clover, who naps; and Turnip, who eats. Bring them home to Cairnhollow.",
      "stages": [
        {
          "id": "goats",
          "description": "Find Bramble (high places), Clover (big furry things) and Turnip (food) and send them home.",
          "objectives": [
            {"type": "Flag", "target": "sr_goat_bramble", "text": "Bramble found"},
            {"type": "Flag", "target": "sr_goat_clover", "text": "Clover found"},
            {"type": "Flag", "target": "sr_goat_turnip", "text": "Turnip found"}
          ],
          "next": "return"
        },
        {
          "id": "return",
          "description": "Tell Pema her goats are home.",
          "objectives": [{"type": "Talk", "target": "sr_pema", "text": "Speak with Pema"}]
        }
      ],
      "rewards": {"xp": 670, "gold": 2500, "choiceItems": ["sr_goatherds_mittens", "sr_cloudwool_shawl", "sr_bell_on_a_string"]}
    },
