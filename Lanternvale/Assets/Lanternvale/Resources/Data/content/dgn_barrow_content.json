  "npcs": [
    {
      "id": "dg4_king_aldwin",
      "name": "King Aldwin the Unquiet",
      "title": "The Last King of the Downs",
      "sprite": "cr_dg4_king_aldwin",
      "portrait": "cr_bandit_chief",
      "bark": "WHO WAKES THE KING?"
    },
    {
      "id": "dg4_aldwin_shade",
      "name": "The Shade of King Aldwin",
      "shortName": "Aldwin's Shade",
      "title": "At Rest, Nearly",
      "sprite": "npc_spirit",
      "portrait": "portrait_spirit",
      "dialogue": "dlg_dg4_aldwin_shade",
      "bark": "Thank you. It is very quiet now."
    }
  ],
  "dialogues": [
    {
      "id": "dlg_dg4_aldwin",
      "start": "a1",
      "nodes": [
        {
          "id": "a1",
          "speaker": "narrator",
          "text": "*The thing on the open sarcophagus sits up. Then it stands, and keeps standing, until its crown of spikes nearly scrapes the vault. Ghost-light leaks from the seams of its armour. Its eyes are two blue flames.*",
          "next": "a2"
        },
        {
          "id": "a2",
          "speaker": "dg4_king_aldwin",
          "text": "WHO WAKES THE KING? *The voice comes from everywhere at once.* Is it the seventh night? Has she come back down on the wind? *The skull turns toward the red light beyond the wall.* ...No. Someone FED it. Someone poured oil on my fire. Was it YOU?",
          "choices": [
            {
              "text": "Your war is over, King Aldwin. The fire was fed by thieves. Let us put it out, and you can sleep again.",
              "check": {"skill": "Religion", "dc": 15, "success": "a_rel", "failure": "a_rel_f"},
              "once": true,
              "tag": "RELIGION"
            },
            {
              "text": "You put the Ashwyrm's fire to sleep and lay down over it. The songs remember you.",
              "check": {"skill": "History", "dc": 13, "success": "a_hist", "failure": "a_hist_f"},
              "once": true,
              "tag": "HISTORY"
            },
            {"text": "(Draw your weapon.)", "next": "a_fight"}
          ]
        },
        {
          "id": "a_rel",
          "speaker": "dg4_king_aldwin",
          "text": "*The blue flames flicker. For a moment the king's voice is only an old man's.* Rest... I would like that. But the oath is in the bones, and the bones do not listen. Then end it, as my huscarls ended things: at the edge of the sword. Do not hold back. I will not be able to.",
          "outcomes": [{"type": "GiveXP", "amount": 200}, {"type": "SetFlag", "key": "dg4_aldwin_heard"}],
          "next": "a_fight"
        },
        {"id": "a_rel_f", "speaker": "dg4_king_aldwin", "text": "Rest? REST? There is no rest while the fire is awake! To arms!", "next": "a_fight"},
        {
          "id": "a_hist",
          "speaker": "dg4_king_aldwin",
          "text": "*The great head tilts.* They sing of it still? Seven nights... *The crown dips.* Then you know what I must do. Whoever stands in my hall while the fire wakes is its servant. Prove you are not, at the edge of the sword.",
          "outcomes": [{"type": "GiveXP", "amount": 150}],
          "next": "a_fight"
        },
        {"id": "a_hist_f", "speaker": "dg4_king_aldwin", "text": "SONGS. Songs do not hold a door. To arms!", "next": "a_fight"},
        {
          "id": "a_fight",
          "speaker": "dg4_king_aldwin",
          "text": "TO ME, MY HUSCARLS! FOR THE DOWNS!",
          "outcomes": [{"type": "StartCombat", "key": "enc_dg4_king_aldwin"}]
        }
      ]
    },
    {
      "id": "dlg_dg4_aldwin_shade",
      "start": "sh_told",
      "nodes": [
        {
          "id": "sh_told",
          "speaker": "dg4_aldwin_shade",
          "text": "*The king's shade sits on the edge of his sarcophagus like a tired grandfather on a garden wall.* Go north, friend. Ash comes down on the wind before she does. You will see it first on the snow.",
          "conditions": [{"type": "Flag", "key": "dg4_shade_spoke"}],
          "fallback": "sh1",
          "choices": [{"text": "Rest well, King Aldwin."}]
        },
        {
          "id": "sh1",
          "speaker": "dg4_aldwin_shade",
          "text": "*A faint, kindly old man in a ghost of a crown, sitting on the edge of his own tomb. He looks very relieved.* Thank you. It is so quiet now. I had forgotten quiet.",
          "choices": [{"text": "What was the fire under your hill?", "next": "sh2"}, {"text": "Rest well, King Aldwin."}]
        },
        {
          "id": "sh2",
          "speaker": "dg4_aldwin_shade",
          "text": "A coal from her fire. Hers — the Ashwyrm, Vyrmathra, who came down from the north on the wind and burned the Downs for seven nights. On the seventh I put her to sleep, and I took one coal from her heart so she could never wake whole. I carried it here and lay down over it.",
          "next": "sh3"
        },
        {
          "id": "sh3",
          "speaker": "dg4_aldwin_shade",
          "text": "*His blue eyes dim.* A man in red scales came, with the gnolls. He fed my coal with oil until it was bright enough to carry, and then he broke it in two and took the brighter half away. North. Toward the peaks. He means to give it back to her. *He looks at you.* She is only sleeping, friend. She was always only sleeping.",
          "outcomes": [{"type": "SetFlag", "key": "dg4_shade_spoke"}, {"type": "GiveXP", "amount": 150}],
          "choices": [{"text": "Then I'll follow him north.", "next": "sh4"}, {"text": "Rest well, King Aldwin."}]
        },
        {
          "id": "sh4",
          "speaker": "dg4_aldwin_shade",
          "text": "Brightwater first. They keep old books there; one of them will remember my name, and hers. And take whatever you like from my hoard. A king should pay his debts.",
          "choices": [{"text": "(Continue.)"}]
        }
      ]
    },
    {
      "id": "dlg_dg4_ember",
      "start": "e_live",
      "nodes": [
        {
          "id": "e_live",
          "speaker": "narrator",
          "text": "*The Hungry Fire: a single coal the size of a fist, red as an eye, in a great iron brazier slick with lamp oil. It is half of something; the broken face of it glitters. It pulses, slow as breathing, and the dark pulses with it.*",
          "conditions": [{"type": "NotFlag", "key": "dg4_ember_smothered"}],
          "fallback": "e_dead",
          "choices": [
            {
              "text": "(Smother the coal with grave-dust and an old shield.)",
              "next": "e_smother",
              "conditions": [{"type": "Flag", "key": "dg4_ruuk_defeated"}]
            },
            {
              "text": "Study the broken face of the coal.",
              "check": {"skill": "Arcana", "dc": 14, "success": "e_arcana", "failure": "e_arcana_f"},
              "once": true,
              "tag": "ARCANA"
            },
            {"text": "(Step back from the heat.)"}
          ]
        },
        {
          "id": "e_smother",
          "speaker": "narrator",
          "text": "*You heap grave-dust on the coal and press an old crowned shield down over the brazier. The red light fights, and hisses, and goes out. For the first time in a long while, the barrow is only dark, and only cold.*",
          "outcomes": [{"type": "SetFlag", "key": "dg4_ember_smothered"}, {"type": "GiveXP", "amount": 150}],
          "choices": [{"text": "(Continue.)"}]
        },
        {
          "id": "e_arcana",
          "speaker": "narrator",
          "text": "*The coal's broken face is fresh — split within the year. This is half an ember. The other, brighter half has been carried away, and somewhere it is still burning.*",
          "outcomes": [{"type": "GiveXP", "amount": 80}],
          "choices": [{"text": "(Step back from the heat.)"}]
        },
        {
          "id": "e_arcana_f",
          "speaker": "narrator",
          "text": "*It is very hot, and very red, and it looks back at you.*",
          "choices": [{"text": "(Step back from the heat.)"}]
        },
        {
          "id": "e_dead",
          "speaker": "narrator",
          "text": "*A cold iron brazier full of grave-dust. Nothing pulses.*",
          "choices": [{"text": "(Step back.)"}]
        }
      ]
    }
  ]
}
